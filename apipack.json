{
  "workspace": "internal-apis",
  "defaultEnvironment": "dev",
  "variables": {
    "env": ["dev", "preprod", "prod"]
  },
  "sources": [
    {
      "name": "users",
      "specUrl": "./fixtures/users.openapi.json",
      "baseUrlTemplate": "https://{{env}}-users.example.com",
      "authProfile": "bearer"
    }
  ],
  "authProfiles": {
    "bearer": {
      "type": "bearer",
      "tokenVariable": "token"
    }
  }
}
